{
  "name": "fmc-frontend",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build && node scripts/seo.ts",
    "og-card": "node scripts/og-card.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --browser.headless=true",
    "test:watch": "vitest --browser.headless=false --browser.ui --open",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@aptabase/web": "0.5.0",
    "@beacio/core": "^1.2.0",
    "effector": "^23.4.4",
    "marked": "^18.1.1",
    "patronum": "^2.3.0",
    "pocketbase": "^0.27.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.89.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^3.1.0"
  }
}
